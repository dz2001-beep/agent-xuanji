{
  "provider": {
    "type": "openai",
    "model": "deepseek-chat"
  },
  "models": ["deepseek-v4-flash", "deepseek-chat", "deepseek-reasoner"],
  "tools": ["fs", "shell", "web"],
  "skills": {
    "dirs": ["./examples/skills"],
    "autoSelect": true,
    "maxSelected": 2
  },
  "mcp": [
    {
      "id": "weather",
      "transport": "stdio",
      "command": "node",
      "args": ["dist/examples/mcp-servers/weather-server.js"]
    }
  ],
  "budget": {
    "maxIterations": 15,
    "toolTimeoutMs": 30000
  }
}
